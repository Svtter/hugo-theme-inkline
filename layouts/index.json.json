{{- $pages := site.RegularPages.ByDate.Reverse -}}
[
{{- range $i, $p := $pages }}{{ if $i }},{{ end }}
{{- $cats := slice }}{{ range $p.GetTerms "categories" }}{{ $cats = $cats | append .Page.Title }}{{ end }}{{ $tags := slice }}{{ range $p.GetTerms "tags" }}{{ $tags = $tags | append .Page.Title }}{{ end }}
{"title":{{ $p.Title | jsonify }},"href":{{ $p.RelPermalink | jsonify }},"date":{{ $p.Date.Format "2006-01-02" | jsonify }},"summary":{{ ($p.Description | default $p.Summary) | plainify | chomp | jsonify }},"categories":{{ $cats | jsonify }},"tags":{{ $tags | jsonify }}}
{{- end }}
]
